# Copy to .env for local development
OPENALEX_EMAIL=

# Azure OpenAI / Azure AI Foundry Credentials (Optional in local development if fallback enabled)
# Set all three of AZURE_OPENAI_ENDPOINT / API_KEY / CHAT_DEPLOYMENT to route
# /analysis and /qa through Azure AI Foundry (backend/app/services/llm_factory.py).
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Plain OpenAI-compatible LLM fallback (used only if the AZURE_OPENAI_* chat
# vars above are not all set). Points at OpenAI itself or any self-hosted
# server that mirrors its chat completions API.
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Azure AI Search Credentials (Optional in local development if fallback enabled)
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_API_KEY=your-azure-search-key
AZURE_SEARCH_INDEX=research2build-evidence

# Azure Storage Connection String
AZURE_STORAGE_CONNECTION_STRING=

# Retrieval Production Hardening
# Set to 'true' for local development to fallback to HashEmbedding & InMemoryVectorStore.
# Set to 'false' in production so unconfigured credentials or service failures fail fast.
RETRIEVAL_ALLOW_LOCAL_FALLBACK=true

# CORE (core.ac.uk) research-paper search. Free key: https://core.ac.uk/services/api
CORE_API_KEY=
