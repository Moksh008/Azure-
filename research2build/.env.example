# Copy to .env for local development
OPENALEX_EMAIL=

# Azure OpenAI Credentials (Optional in local development if fallback enabled)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Azure AI Search Credentials (Optional in local development if fallback enabled)
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_API_KEY=your-azure-search-key
AZURE_SEARCH_INDEX=research2build-evidence

# Azure Storage Connection String
AZURE_STORAGE_CONNECTION_STRING=

# Retrieval Production Hardening
# Set to 'true' for local development to fallback to HashEmbedding & InMemoryVectorStore.
# Set to 'false' in production so unconfigured credentials or service failures fail fast.
RETRIEVAL_ALLOW_LOCAL_FALLBACK=true
