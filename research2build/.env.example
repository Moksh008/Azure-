# Copy to .env for local development
OPENALEX_EMAIL=

# Azure OpenAI / Azure AI Foundry Credentials (Optional in local development if fallback enabled)
# Set all three of AZURE_OPENAI_ENDPOINT / API_KEY / CHAT_DEPLOYMENT to route
# /analysis and /qa through Azure AI Foundry (backend/app/services/llm_factory.py).
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Plain OpenAI-compatible LLM fallback (used only if the AZURE_OPENAI_* chat
# vars above are not all set). Points at OpenAI itself or any self-hosted
# server that mirrors its chat completions API.
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Local LLM via Ollama (https://ollama.com) ---------------------------
# `ollama pull qwen3:8b` then point LLM_* at the local server. Any non-empty
# LLM_API_KEY works (Ollama ignores it). LLM_REASONING_EFFORT=none disables
# qwen3's thinking mode so answers stream immediately.
# LLM_ENDPOINT=http://localhost:11434/v1/chat/completions
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:8b
# LLM_REASONING_EFFORT=none
# LLM_TIMEOUT_SECONDS=300

# --- Local embeddings via Ollama -----------------------------------------
# `ollama pull nomic-embed-text`. Takes precedence over the hash fallback
# whenever OLLAMA_BASE_URL or OLLAMA_EMBEDDING_MODEL is set (but Azure
# OpenAI still wins if configured).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Local persistent vector store (ChromaDB) ----------------------------
# Used whenever Azure AI Search is not configured. Data survives restarts.
CHROMA_PATH=./chroma_db

# Azure AI Search Credentials (Optional in local development if fallback enabled)
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_API_KEY=your-azure-search-key
AZURE_SEARCH_INDEX=research2build-evidence

# Azure Storage Connection String
AZURE_STORAGE_CONNECTION_STRING=

# Retrieval Production Hardening
# Set to 'true' for local development to fallback to HashEmbedding & InMemoryVectorStore.
# Set to 'false' in production so unconfigured credentials or service failures fail fast.
RETRIEVAL_ALLOW_LOCAL_FALLBACK=true

# CORE (core.ac.uk) research-paper search. Free key: https://core.ac.uk/services/api
CORE_API_KEY=
